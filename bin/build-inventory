#!/usr/bin/env php
<?php declare(strict_types=1);

/**
 * bin/build-inventory
 *
 * Reads a delimited file of EZBorrow-style circulation data and builds
 * FOLIO Instance, Holdings, and Item records from it, linked together
 * (Holdings.instanceId -> Instance.id, Item.holdingsRecordId ->
 * Holdings.id). Build-only: this script never writes to a live FOLIO
 * tenant, it only writes JSON files — the one exception is a couple of
 * read-only lookups (see `--config` below): the tenant's existing
 * statistical codes, made only if a mapping file actually maps
 * `statisticalCodeIds`; and its holdings sources, made only if the
 * holdings mapping maps `sourceId` (which it does by default — see
 * `mapping/holdings_field_mapping.json`, hard-coded to `FOLIO`).
 *
 * Rows are *not* simply 1:1:1 with instance/holdings/item — repeated
 * rows sharing the same title + author collapse into a single shared
 * Instance, and within that, rows also sharing the same call number +
 * location collapse into a single shared Holdings; every row still
 * produces its own Item, attached to whichever (possibly shared)
 * Holdings its own call number/location matches. See
 * \SourceFolioRecords\RecordGrouping for the exact grouping rules.
 *
 * Every record's own `id` is deterministic (uuid5) — see
 * \SourceFolioRecords\ReferenceRegistry — so re-running against the same
 * input reproduces identical ids rather than inventing new ones each
 * time: an Instance's id is derived from its title+author grouping key,
 * a Holdings' id from its title+author+call number+location grouping
 * key, and an Item's id from its own row's `legacyIdentifier` (the
 * row's barcode when non-empty, else a hash of title/author/publication
 * date/ISBN — see \SourceFolioRecords\LegacyIdentifier). An Instance's
 * `legacyIdentifier` field records the barcode-or-hash identifier of
 * whichever row first created it.
 *
 * If a record fails validation (e.g. a missing `title`), that record —
 * and anything downstream of it for that row (a failed Instance also
 * skips that row's Holdings/Item; a failed Holdings also skips that
 * row's Item) — is skipped and logged, rather than shipping a
 * known-bad record. An already-successfully-built shared Instance or
 * Holdings from an earlier row is never discarded because a later row
 * sharing its key fails. A `statisticalCodeIds` lookup that didn't
 * resolve is logged as a warning instead and does *not* skip anything
 * — see \SourceFolioRecords\RowValidation.
 *
 * `instanceTypeId` (Instance) is a required field with no source column
 * in ezborrow.tsv. It can be supplied three ways, checked in this order:
 * a `--resource-type` CLI option; a literal `value` already filled into
 * the mapping file; or, if neither is given, a check of whether the
 * tenant already has an instance type named `text` — used automatically
 * if so, rather than prompting — falling back to an interactive prompt
 * (once per run, reused for every record) only if none of that applies.
 * That tenant check needs `--config`; if it's omitted but a *.ini file
 * exists at the project root, you're prompted to pick one to use as
 * `--config` (see \SourceFolioRecords\Cli\ConfigFile::promptFor()) before
 * this runs, so `text`
 * actually gets the chance to resolve instead of falling straight to the
 * prompt for lack of a config. See resolveResourceTypeLiteral().
 *
 * `materialTypeId` and `permanentLoanTypeId` (Item), and
 * `permanentLocationId` (Holdings), never prompt: each uses the row's own
 * mapped column(s) (`Material_Format`; none;
 * `Item_Permanent_Shelving_Location`/`Item_Holding_Location`), falling
 * back to each mapping file's own literal `fallback_value` (`Migration`
 * for the material type and location; `Can circulate` for the loan type
 * — see each mapping file; `--material-type`/`--loan-type` CLI options
 * can still override the whole field) whenever a row's own value is
 * blank. If the tenant
 * (via `--config`) has no material type, loan type, or location actually
 * named by its configured fallback, the whole run quits immediately
 * rather than only failing per-row once that fallback is needed — see
 * checkLiveFallbacksExist().
 *
 * `--test` forces `materialTypeId` and `permanentLocationId` to the
 * literal name "Migration" for every row, ignoring both the row's own
 * column data and each field's configured `fallback_value` — then
 * resolves that name the normal way, via a live lookup against the
 * tenant's real material types/locations (so `--config` is required
 * when `--test` is given). Meant for testing a build against a real
 * tenant before its real location/material type reference data has been
 * loaded yet: as long as the tenant has a material type and a location
 * each literally named "Migration" already, every record resolves
 * against those rather than needing every real value up front.
 *
 * See \SourceFolioRecords\RecordBuilder, \SourceFolioRecords\Mapping\FieldMapper,
 * \SourceFolioRecords\Io\DelimitedFileReader, \SourceFolioRecords\Io\ErrorLog,
 * and the schema classes under \SourceFolioRecords\Schema for the field
 * mapping/validation rules.
 *
 * Usage:
 *   php bin/build-inventory --input=ezborrow.tsv [options]
 *
 * Options:
 *   --input=PATH             Delimited input file. If omitted, prompted
 *                             for interactively.
 *   --mapping-dir=PATH        Directory holding instance_field_mapping.json,
 *                             holdings_field_mapping.json, and
 *                             item_field_mapping.json (e.g. mapping/ezborrow,
 *                             mapping/source_folio). If omitted, prompted
 *                             for interactively (lists every subfolder
 *                             under mapping/ at the project root).
 *   --output-dir=PATH         Directory to write instances.json/holdings.json/
 *                             items.json (created if missing). Default: a
 *                             fresh subdirectory of output/ at the project
 *                             root, named after the input file plus a
 *                             timestamp (e.g. output/ezborrow_20260925_
 *                             154212_9c3ada/) so each run's output is kept
 *                             separate rather than overwriting the last
 *                             run's files — matching the run's default
 *                             error log's own name under logs/.
 *   --format=json|ndjson      Output format for all three files (default:
 *                             ndjson — one JSON object per line; "json"
 *                             writes a single JSON array per file instead).
 *   --delimiter=CHAR          Field delimiter (default: tab). Accepts "tab",
 *                             "pipe", "semicolon", "comma" as convenience names.
 *   --enclosure=CHAR          Field quote/enclosure character (default: ").
 *   --list-delimiter=STR      Delimiter used *within* a single cell for
 *                             multi-value fields (default: |).
 *   --resource-type=NAME      Literal resource type name for every instance's
 *                             instanceTypeId — skips the tenant check and
 *                             the interactive prompt.
 *   --material-type=NAME      Literal material type name for every item's
 *                             materialTypeId, overriding the row's own
 *                             Material_Format column and the Migration
 *                             fallback.
 *   --loan-type=NAME          Literal permanent loan type name for every
 *                             item's permanentLoanTypeId, overriding the
 *                             Can circulate fallback.
 *   --reference-map-dir=PATH  Folder of reference data maps (default:
 *                             /working/migration/mapping_files). Locations,
 *                             call number types, loan types and material
 *                             types each prompt for a .tsv from it (blank
 *                             skips). Skip prompts with --location-map=,
 *                             --call-number-type-map=, --loan-type-map=,
 *                             --material-type-map=, --item-status-map= (path or file name).
 *                             Maps: legacy value<TAB>FOLIO name/code; `*` =
 *                             default, `(blank)` = empty values.
 *   --statistical-code=X      `none`, or a statistical code UUID, to skip the
 *                             statistical code questions. Otherwise you're asked
 *                             whether to include one, then pick a code type and
 *                             one of its codes (applied to all three record types).
 *   --suppress[=no]           Set discoverySuppress on every Instance (not
 *                             holdings/items) without prompting; `=no` skips
 *                             it without prompting. If omitted, you're asked.
 *   --test                    Force materialTypeId and permanentLocationId
 *                             to the literal name "Migration" for every
 *                             row, resolved via a live lookup against the
 *                             tenant (requires --config) instead of each
 *                             row's own column data or configured
 *                             fallback — for testing a build against a
 *                             real tenant before its real location/
 *                             material type reference data is loaded.
 *   --config=PATH             INI file with FOLIO connection settings, per
 *                             \phpFolioClient\FolioConfig (okapiUrl,
 *                             tenant_id, username, password; sslVerify/
 *                             timeout/debug/etc. optional). If omitted and
 *                             any *.ini file exists at the project root,
 *                             you're prompted to pick one (see
 *                             \SourceFolioRecords\Cli\ConfigFile::promptFor())
 *                             rather than having to type its path.
 *                             Required (one way or the other) if a
 *                             mapping file's
 *                             `statisticalCodeIds` entry has a literal
 *                             `value` filled in, and/or any `live:`
 *                             reference field does (`sourceId`,
 *                             `permanentLocationId`, `materialTypeId`,
 *                             `permanentLoanTypeId`, etc. — see each
 *                             Schema class) — used for read-only lookups
 *                             to verify each configured id/name against
 *                             the tenant's real reference data.
 *   --error-log=PATH          Validation log for this run (default: a
 *                             fresh, timestamped file under logs/ at the
 *                             project root, created automatically).
 *   --help                   Show this message.
 */

require __DIR__ . '/../vendor/autoload.php';

use SourceFolioRecords\Casting\ValueCaster;
use SourceFolioRecords\Cli\ConfigFile;
use SourceFolioRecords\Cli\Options;
use SourceFolioRecords\HoldingsSourceResolver;
use SourceFolioRecords\Io\DelimitedFileReader;
use SourceFolioRecords\Io\ErrorLog;
use SourceFolioRecords\LegacyIdentifier;
use SourceFolioRecords\LiveReferenceResolver;
use SourceFolioRecords\LocationResolver;
use SourceFolioRecords\Mapping\FieldMapper;
use SourceFolioRecords\Mapping\ValueMap;
use SourceFolioRecords\RecordBuilder;
use SourceFolioRecords\RecordGrouping;
use SourceFolioRecords\ReferenceRegistry;
use SourceFolioRecords\RowValidation;
use SourceFolioRecords\Schema\HoldingsSchema;
use SourceFolioRecords\Schema\InstanceSchema;
use SourceFolioRecords\Schema\ItemSchema;
use SourceFolioRecords\StatisticalCodeResolver;
use phpFolioClient\FolioAuth;
use phpFolioClient\FolioClient;
use phpFolioClient\FolioConfig;
use phpFolioClient\FolioReferenceDataManager;
use phpFolioClient\FolioUtils;

const PROJECT_ROOT = __DIR__ . '/..';
const REFERENCE_MAP_DIR = '/working/migration/mapping_files';

/**
 * List every immediate subdirectory of `$mappingRootDir` — each expected
 * to hold one source file's own `instance_field_mapping.json`/
 * `holdings_field_mapping.json`/`item_field_mapping.json` set (e.g.
 * `mapping/ezborrow/`, `mapping/source_folio/`) — sorted by name.
 *
 * @return Subdirectory names (not full paths); empty if `$mappingRootDir`
 *         doesn't exist or has no subdirectories.
 */
function listMappingSets(string $mappingRootDir): array {
    if (!is_dir($mappingRootDir)) {
        return [];
    }
    $names = [];
    foreach (scandir($mappingRootDir) ?: [] as $entry) {
        if ($entry !== '.' && $entry !== '..' && is_dir("$mappingRootDir/$entry")) {
            $names[] = $entry;
        }
    }
    sort($names);
    return $names;
}

/**
 * Prompt for which mapping set (subfolder of `$mappingRootDir`) to use,
 * when `--mapping-dir` wasn't given — building the wrong source file
 * against the wrong mapping set (e.g. tagging `source_folio.tsv`
 * records with `ezborrow`'s statistical code) fails silently rather
 * than erroring, so this asks rather than defaulting to any one of them.
 * Accepts either the listed number or the bare subfolder name (never a
 * path — `$mappingRootDir` is assumed, so typing e.g. `ezborrow` is
 * enough, not `mapping/ezborrow`).
 *
 * @return The chosen mapping set's full path.
 * @throws \RuntimeException If `$mappingRootDir` has no subdirectories
 *                     to choose from, or the typed answer matches none
 *                     of them.
 */
function promptForMappingDir(string $mappingRootDir): string {
    $sets = listMappingSets($mappingRootDir);
    if ($sets === []) {
        throw new \RuntimeException("no mapping sets found under '$mappingRootDir'");
    }

    fwrite(STDERR, "Which set of maps should be used?\n");
    foreach ($sets as $i => $name) {
        fwrite(STDERR, '  ' . ($i + 1) . ") $name\n");
    }
    fwrite(STDERR, 'Enter a number, or just the name above (not a path): ');
    $answer = trim((string) fgets(STDIN));

    if (ctype_digit($answer) && isset($sets[((int) $answer) - 1])) {
        return "$mappingRootDir/{$sets[((int) $answer) - 1]}";
    }
    if (in_array($answer, $sets, true)) {
        return "$mappingRootDir/$answer";
    }
    throw new \RuntimeException("'$answer' does not match any mapping set under '$mappingRootDir'");
}

/**
 * Choose a reference data map (*.tsv) from `$dir` for one kind of reference
 * data — offering only files whose name contains `$keyword` (normalized,
 * lowercase) unless the user types `show_all` (or nothing matched).
 * Skipped entirely if `$cliOptionValue` (a path, or a file name within
 * `$dir`) already names one. Enter skips (no map for this kind).
 *
 * @return The chosen map, or null if skipped.
 * @throws \RuntimeException If the answer doesn't match a file.
 */
function promptForReferenceMap(string $label, string $dir, string $cliOptionValue, string $keyword): ?ValueMap {
    $path = $cliOptionValue;
    if ($path === '') {
        $all = [];
        foreach (scandir($dir) ?: [] as $f) {
            if (str_ends_with($f, '.tsv') && is_file("$dir/$f")) {
                $all[] = $f;
            }
        }
        if ($all === []) {
            throw new \RuntimeException("no .tsv files found in '$dir'");
        }
        // Guess: files whose name (ignoring case, `_`, `-`, spaces) contains the keyword.
        $guesses = array_values(array_filter(
            $all,
            fn(string $f): bool => str_contains(preg_replace('/[^a-z0-9]/', '', strtolower($f)), $keyword)
        ));
        $showAll = $guesses === [];
        while (true) {
            $files = $showAll ? $all : $guesses;
            fwrite(STDERR, "Which $label map should be used?" . ($showAll && $guesses === [] ? " (no likely match; showing all)" : '') . "\n");
            foreach ($files as $i => $f) {
                fwrite(STDERR, '  ' . ($i + 1) . ") $f\n");
            }
            if (!$showAll) {
                fwrite(STDERR, "  show_all) list every map in $dir\n");
            }
            fwrite(STDERR, 'Enter a number or file name' . ($showAll ? '' : ', or show_all') . ' (blank to skip): ');
            $answer = trim((string) fgets(STDIN));
            if ($answer === '') {
                return null;
            }
            if (!$showAll && strcasecmp($answer, 'show_all') === 0) {
                $showAll = true;
                continue;
            }
            if (ctype_digit($answer) && isset($files[((int) $answer) - 1])) {
                $path = "$dir/{$files[((int) $answer) - 1]}";
            } elseif (in_array($answer, $all, true)) {
                $path = "$dir/$answer";
            } else {
                throw new \RuntimeException("'$answer' does not match any file in '$dir'");
            }
            break;
        }
    } elseif (!str_contains($path, '/') && is_file("$dir/$path")) {
        $path = "$dir/$path";
    }
    return ValueMap::fromFile($path);
}

/**
 * If a mapping file leaves a required reference field with no literal
 * value and no mapped column, and no CLI option supplied one either,
 * prompt for one value to use for every record in this run, and inject
 * it as that field's literal via {@see FieldMapper::setLiteral()}.
 *
 * @param $cliOptionValue The relevant `--resource-type`/`--material-type`/
 *                        `--loan-type` option's value, or `''` if not given.
 */
function promptForLiteralIfUnmapped(FieldMapper $mapper, string $field, string $cliOptionValue, string $promptLabel): void {
    if ($cliOptionValue !== '') {
        $mapper->setLiteral($field, $cliOptionValue);
        return;
    }
    if ($mapper->isMapped($field)) {
        return;
    }
    fwrite(STDERR, "$promptLabel: ");
    $answer = trim((string) fgets(STDIN));
    if ($answer !== '') {
        $mapper->setLiteral($field, $answer);
    }
}

/**
 * Whether the tenant (via `--config`) already has an instance type
 * literally named `$name` (case-insensitive) — a standalone lookup, not
 * one of {@see buildLiveResolvers()}'s resolvers, since this needs to run
 * *before* that function's own "is instanceTypeId mapped yet" check (a
 * literal set here would otherwise make it look pre-mapped). Returns
 * `false` if `--config` wasn't given or the lookup fails, so the caller
 * falls back to prompting instead — but a failed lookup (bad
 * credentials, wrong tenant_id, unreachable okapiUrl, etc.) is printed to
 * stderr rather than silently swallowed, since a silent `false` here is
 * indistinguishable from "checked fine, tenant genuinely has no `$name`".
 */
function tenantHasInstanceTypeNamed(string $configOption, string $name): bool {
    if ($configOption === '') {
        return false;
    }
    try {
        $config = new FolioConfig($configOption);
        $client = new FolioClient($config, new FolioAuth($config), new FolioUtils());
        $namesById = fetchNamesById($client, 'instance-types');
    } catch (\Throwable $e) {
        fwrite(STDERR, "Warning: couldn't check '$configOption' for an instance type named '$name': " . $e->getMessage() . "\n");
        return false;
    }
    foreach ($namesById as $existingName) {
        if (strcasecmp($existingName, $name) === 0) {
            return true;
        }
    }
    return false;
}

/**
 * Same job as {@see promptForLiteralIfUnmapped()} for `instanceTypeId`
 * specifically, but with an extra check in between: if the tenant already
 * has an instance type named `text` (FOLIO's usual default for textual
 * resources), use it instead of prompting — the tenant can answer this
 * one itself, so don't ask the person running the script something FOLIO
 * already knows. Only applies when `--config` was given; otherwise there's
 * no tenant to check, and this falls straight through to the prompt.
 */
function resolveResourceTypeLiteral(FieldMapper $mapper, string $cliOptionValue, string $configOption): void {
    if ($cliOptionValue !== '') {
        $mapper->setLiteral('instanceTypeId', $cliOptionValue);
        return;
    }
    if ($mapper->isMapped('instanceTypeId')) {
        return;
    }
    if (tenantHasInstanceTypeNamed($configOption, 'text')) {
        $mapper->setLiteral('instanceTypeId', 'text');
        return;
    }
    $names = tenantInstanceTypeNames($configOption);
    if ($names !== []) {
        fwrite(STDERR, "Which resource type should every instance use?\n");
        foreach ($names as $i => $name) {
            fwrite(STDERR, '  ' . ($i + 1) . ") $name\n");
        }
        fwrite(STDERR, 'Enter a number or name: ');
        $answer = trim((string) fgets(STDIN));
        if (ctype_digit($answer) && isset($names[((int) $answer) - 1])) {
            $answer = $names[((int) $answer) - 1];
        }
    } else {
        fwrite(STDERR, 'Enter the resource type to use for every instance: ');
        $answer = trim((string) fgets(STDIN));
    }
    if ($answer !== '') {
        $mapper->setLiteral('instanceTypeId', $answer);
    }
}

/**
 * The tenant's instance type names (from `/instance-types`), sorted, for
 * choosing from. Empty if `--config` wasn't given or the lookup fails
 * (a failure is printed to stderr), so the caller falls back to free text.
 *
 * @return list<string>
 */
function tenantInstanceTypeNames(string $configOption): array {
    if ($configOption === '') {
        return [];
    }
    try {
        $config = new FolioConfig($configOption);
        $client = new FolioClient($config, new FolioAuth($config), new FolioUtils());
        $names = array_values(fetchNamesById($client, 'instance-types'));
    } catch (\Throwable $e) {
        fwrite(STDERR, "Warning: couldn't list instance types from '$configOption': " . $e->getMessage() . "\n");
        return [];
    }
    sort($names, SORT_NATURAL | SORT_FLAG_CASE);
    return $names;
}

/**
 * Write a list of records to a path as json or ndjson. If there are no
 * records, no file is created (any stale file left over from a previous
 * run at that path is removed instead), rather than shipping an empty/
 * near-empty file.
 */
function writeRecords(array $records, string $path, string $format): void {
    if ($records === []) {
        if (file_exists($path)) {
            unlink($path);
        }
        return;
    }
    $handle = fopen($path, 'w');
    if ($format === 'ndjson') {
        foreach ($records as $record) {
            fwrite($handle, json_encode($record, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
        }
    } else {
        fwrite($handle, json_encode($records, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
    }
    fclose($handle);
}

/**
 * Whether a mapping file has at least one mapped `statisticalCodeIds[N]`
 * entry (a literal `value`, or a legacy/fallback column) — `[N]` is a
 * repeatable scalar field (see \SourceFolioRecords\Schema\InstanceSchema's
 * `SCALAR_LISTS`), so there's no single bare `statisticalCodeIds` key to
 * check with {@see FieldMapper::isMapped()} directly.
 */
function mapperHasStatisticalCodes(FieldMapper $mapper): bool {
    foreach ($mapper->scalarListIndicesFor('statisticalCodeIds') as $index) {
        if ($mapper->isMapped("statisticalCodeIds[$index]")) {
            return true;
        }
    }
    return false;
}

/**
 * Whether a nested-group sub-field has at least one mapped instance
 * (e.g. `identifiers[N].identifierTypeId` for some N) — mirrors
 * {@see mapperHasStatisticalCodes()}, but for a `NESTED_GROUPS` field
 * rather than a `SCALAR_LISTS` one.
 */
function mapperHasNestedGroupField(FieldMapper $mapper, string $schemaKey, string $subField): bool {
    foreach ($mapper->indicesFor($schemaKey) as $index) {
        if ($mapper->isMapped("{$schemaKey}[{$index}].{$subField}")) {
            return true;
        }
    }
    return false;
}

/**
 * Fetch every record's id/name from a FOLIO endpoint that
 * `phpFolioClient\FolioReferenceDataManager` has no dedicated helper
 * for (instance types, contributor name types, identifier types) —
 * same technique {@see HoldingsSourceResolver::fromClient()} uses.
 */
function fetchNamesById(FolioClient $client, string $endpoint): array {
    $namesById = [];
    foreach ($client->get($endpoint) as $record) {
        $namesById[$record->id] = $record->name;
    }
    return $namesById;
}

/**
 * Build every live-tenant resolver this run needs — a
 * {@see StatisticalCodeResolver} if any of the three mapping files maps
 * a `statisticalCodeIds[N]` entry, a {@see HoldingsSourceResolver} if
 * the holdings mapping maps `sourceId`, a {@see LocationResolver} if
 * the holdings mapping maps `permanentLocationId` (the only
 * `HoldingsSchema::SCALAR_FIELDS` location field typed `live:location`
 * today), and a {@see LiveReferenceResolver} per other `live:<namespace>`
 * field actually mapped (`instanceType`, `materialType`, `loanType`,
 * `contributorNameType`, `identifierType`) — sharing a single FOLIO
 * client (and thus a single login) between all of them rather than
 * logging in more than once. Any resolver is an empty (no-network) one
 * if nothing needs it.
 *
 * @param $instanceMapper, $holdingsMapper, $itemMapper The three mappers.
 * @param $configOption The `--config` option's value, or `''` if not given.
 * @return `[$statisticalCodes, $holdingsSources, $locations, $liveReferences]`
 *         — the last a `namespace => LiveReferenceResolver` array.
 * @throws \RuntimeException If a live lookup is needed but `--config`
 *                     wasn't given, or the config file couldn't be loaded.
 */
function buildLiveResolvers(FieldMapper $instanceMapper, FieldMapper $holdingsMapper, FieldMapper $itemMapper, string $configOption): array {
    $needsStatisticalCodes = mapperHasStatisticalCodes($instanceMapper)
        || mapperHasStatisticalCodes($holdingsMapper)
        || mapperHasStatisticalCodes($itemMapper);
    $needsHoldingsSource = $holdingsMapper->isMapped('sourceId');
    // Only permanentLocationId is `live:location` today; temporaryLocationId
    // stays fabricated via `ref:location` (see HoldingsSchema's docblock),
    // so its own mapped-ness doesn't need a live lookup.
    $needsLocation = $holdingsMapper->isMapped('permanentLocationId');

    $liveReferenceNeeds = [
        'instanceType' => $instanceMapper->isMapped('instanceTypeId'),
        'materialType' => $itemMapper->isMapped('materialTypeId'),
        'loanType' => $itemMapper->isMapped('permanentLoanTypeId'),
        'callNumberType' => $holdingsMapper->isMapped('callNumberTypeId'),
        'contributorNameType' => mapperHasNestedGroupField($instanceMapper, 'contributors', 'contributorNameTypeId'),
        'identifierType' => mapperHasNestedGroupField($instanceMapper, 'identifiers', 'identifierTypeId'),
    ];

    if (!$needsStatisticalCodes && !$needsHoldingsSource && !$needsLocation && !in_array(true, $liveReferenceNeeds, true)) {
        return [StatisticalCodeResolver::empty(), HoldingsSourceResolver::empty(), LocationResolver::empty(), []];
    }
    if ($configOption === '') {
        throw new \RuntimeException(
            "a mapping file needs a live reference lookup (statistical codes, Holdings' sourceId/location, or Instance/Item reference fields), but --config wasn't given"
        );
    }

    $config = new FolioConfig($configOption);
    $client = new FolioClient($config, new FolioAuth($config), new FolioUtils());
    $referenceDataManager = new FolioReferenceDataManager($client);

    $statisticalCodes = $needsStatisticalCodes
        ? StatisticalCodeResolver::fromReferenceDataManager($referenceDataManager)
        : StatisticalCodeResolver::empty();
    $holdingsSources = $needsHoldingsSource
        ? HoldingsSourceResolver::fromClient($client)
        : HoldingsSourceResolver::empty();
    $locations = $needsLocation
        ? LocationResolver::fromReferenceDataManager($referenceDataManager)
        : LocationResolver::empty();

    $liveReferenceEndpoints = [
        'instanceType' => 'instance-types',
        'callNumberType' => 'call-number-types',
        'contributorNameType' => 'contributor-name-types',
        'identifierType' => 'identifier-types',
    ];
    $liveReferences = [];
    foreach ($liveReferenceNeeds as $namespace => $needed) {
        if (!$needed) {
            continue;
        }
        $namesById = match ($namespace) {
            'materialType' => $referenceDataManager->getMaterialTypes(),
            'loanType' => $referenceDataManager->getLoanTypes(),
            default => fetchNamesById($client, $liveReferenceEndpoints[$namespace]),
        };
        $liveReferences[$namespace] = new LiveReferenceResolver($namesById);
    }

    return [$statisticalCodes, $holdingsSources, $locations, $liveReferences];
}

/**
 * Verify the tenant actually has whatever `materialTypeId`,
 * `permanentLoanTypeId` (Item), and `permanentLocationId` (Holdings) each
 * fall back to (their mapping file's own `fallback_value` — e.g.
 * `Material_Format`'s configured "if blank, use X" literal — read via
 * {@see FieldMapper::fallbackValueFor()} rather than assumed here) for
 * whenever a row's own column data is blank. Checked once, right after
 * {@see buildLiveResolvers()}, so a tenant missing one of these fallbacks
 * quits the whole run immediately instead of only surfacing as a per-row
 * validation error on whichever rows happen to need it. Each of the
 * three is only checked if its field actually has a `fallback_value`.
 *
 * @return One message per problem found; empty if none.
 */
function checkLiveFallbacksExist(FieldMapper $itemMapper, FieldMapper $holdingsMapper, LocationResolver $locations, array $liveReferences): array {
    $problems = [];

    $materialTypeFallback = $itemMapper->fallbackValueFor('materialTypeId');
    if ($materialTypeFallback !== null) {
        $materialTypes = $liveReferences['materialType'] ?? LiveReferenceResolver::empty();
        if ($materialTypes->idForName($materialTypeFallback) === null) {
            $problems[] = "the tenant has no material type named '$materialTypeFallback' (materialTypeId's configured fallback, used when a row's own material type is blank).";
        }
    }

    $loanTypeFallback = $itemMapper->fallbackValueFor('permanentLoanTypeId');
    if ($loanTypeFallback !== null) {
        $loanTypes = $liveReferences['loanType'] ?? LiveReferenceResolver::empty();
        if ($loanTypes->idForName($loanTypeFallback) === null) {
            $problems[] = "the tenant has no loan type named '$loanTypeFallback' (permanentLoanTypeId's configured fallback, used when a row's own loan type is blank).";
        }
    }

    $locationFallback = $holdingsMapper->fallbackValueFor('permanentLocationId');
    if ($locationFallback !== null && $locations->idForName($locationFallback) === null) {
        $problems[] = "the tenant has no location named '$locationFallback' (permanentLocationId's configured fallback, used when a row's own shelving location is blank).";
    }

    return $problems;
}

/**
 * Record that `$field`'s value for this row resolved to the placeholder
 * 'Migration' (via a map's `*` default or the mapping's fallback), so it
 * can be listed at the end as something still needing a map entry.
 *
 * @param array<string, array<string, int>> $tally field => legacy value => row count
 */
function tallyMigrationFallback(array &$tally, FieldMapper $mapper, string $field, array $row): void {
    if (strcasecmp((string) $mapper->resolve($field, $row), 'Migration') !== 0) {
        return;
    }
    $legacy = $mapper->sourceValue($field, $row);
    $legacy = $legacy === '' ? '(blank)' : $legacy;
    $tally[$field][$legacy] = ($tally[$field][$legacy] ?? 0) + 1;
}

/**
 * Interactively decide which statistical code (if any) every record gets:
 * ask whether to include one, then list the tenant's statistical code
 * types, then only the codes of the chosen type. Replaces whatever
 * `statisticalCodeIds[N]` entries the three mapping files had (all three
 * record types get the same chosen code); answering no removes them.
 *
 * @param $cliOption `--statistical-code`: `none`, or a statistical code UUID; `''` to prompt.
 * @throws \RuntimeException If a code is wanted but there's no `--config`, or the tenant has none to offer.
 */
function chooseStatisticalCode(array $mappers, string $configOption, string $cliOption): void {
    $codeId = null;
    if ($cliOption !== '') {
        $codeId = strcasecmp($cliOption, 'none') === 0 ? null : $cliOption;
    } else {
        fwrite(STDERR, 'Include a statistical code on the records? [y/N]: ');
        if (in_array(strtolower(trim((string) fgets(STDIN))), ['y', 'yes'], true)) {
            if ($configOption === '') {
                throw new \RuntimeException("choosing a statistical code needs a tenant to list them from, but --config wasn't given");
            }
            $config = new FolioConfig($configOption);
            $client = new FolioClient($config, new FolioAuth($config), new FolioUtils());
            $types = fetchNamesById($client, 'statistical-code-types');
            asort($types, SORT_NATURAL | SORT_FLAG_CASE);
            $typeId = pickFromList('statistical code type', array_map(null, array_keys($types), array_values($types)));
            $codes = [];
            foreach ($client->get('statistical-codes') as $c) {
                if (($c->statisticalCodeTypeId ?? null) === $typeId) {
                    $codes[] = [$c->id, ($c->code ?? '') . ' - ' . ($c->name ?? '')];
                }
            }
            usort($codes, fn($a, $b) => strnatcasecmp($a[1], $b[1]));
            if ($codes === []) {
                throw new \RuntimeException("the tenant has no statistical codes of type '{$types[$typeId]}'");
            }
            $codeId = pickFromList('statistical code', $codes);
        }
    }

    foreach ($mappers as $mapper) {
        $mapper->removeScalarList('statisticalCodeIds');
        if ($codeId !== null) {
            $mapper->setLiteral('statisticalCodeIds[0]', $codeId);
        }
    }
}

/**
 * Show a numbered list of `[id, label]` pairs and return the chosen id.
 *
 * @throws \RuntimeException If the answer isn't a listed number.
 */
function pickFromList(string $what, array $items): string {
    if ($items === []) {
        throw new \RuntimeException("no {$what}s found in the tenant");
    }
    fwrite(STDERR, "Which $what?\n");
    foreach ($items as $i => [, $label]) {
        fwrite(STDERR, '  ' . ($i + 1) . ") $label\n");
    }
    fwrite(STDERR, 'Enter a number: ');
    $answer = trim((string) fgets(STDIN));
    if (!ctype_digit($answer) || !isset($items[((int) $answer) - 1])) {
        throw new \RuntimeException("'$answer' is not a listed $what");
    }
    return $items[((int) $answer) - 1][0];
}

/**
 * Print (and log) every legacy location/material type value that fell back
 * to 'Migration', sorted by how often it occurred.
 *
 * @param array<string, array<string, int>> $tally
 */
function reportMigrationFallbacks(array $tally, ErrorLog $errorLog): void {
    $labels = ['permanentLocationId' => 'Locations', 'materialTypeId' => 'Material types'];
    foreach ($labels as $field => $label) {
        $values = $tally[$field] ?? [];
        if ($values === []) {
            continue;
        }
        arsort($values);
        $lines = ["$label that resolved to 'Migration' and need a map entry (" . count($values) . '):'];
        foreach ($values as $value => $count) {
            $lines[] = sprintf('  %s  (%d)', $value, $count);
        }
        $lines[] = '';
        foreach ($lines as $line) {
            fwrite(STDERR, $line . "\n");
            $errorLog->write($line);
        }
    }
}

function printHelp(): void {
    $source = file_get_contents(__FILE__);
    if (preg_match('#/\*\*(.*?)\*/#s', (string) $source, $m)) {
        foreach (explode("\n", $m[1]) as $line) {
            echo ltrim(rtrim($line), " \t*") . "\n";
        }
    }
}

function main(array $argv): int {
    $options = Options::parse($argv);

    if (isset($options['help'])) {
        printHelp();
        return 0;
    }
    $inputPath = is_string($options['input'] ?? null) ? $options['input'] : '';
    if ($inputPath === '') {
        fwrite(STDERR, 'Enter the path to the delimited input file: ');
        $inputPath = trim((string) fgets(STDIN));
    }
    if ($inputPath === '') {
        fwrite(STDERR, "Error: --input is required. Use --help for usage.\n");
        return 1;
    }

    if (is_string($options['mapping-dir'] ?? null)) {
        $mappingDir = rtrim($options['mapping-dir'], '/\\');
    } else {
        try {
            $mappingDir = promptForMappingDir(PROJECT_ROOT . '/mapping');
        } catch (\Throwable $e) {
            fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
            return 1;
        }
    }
    $runToken = ErrorLog::runToken($inputPath);
    $outputDir = is_string($options['output-dir'] ?? null)
        ? rtrim($options['output-dir'], '/\\')
        : PROJECT_ROOT . '/output/' . $runToken;
    $format = is_string($options['format'] ?? null) ? $options['format'] : 'ndjson';
    $delimiter = Options::resolveDelimiter(is_string($options['delimiter'] ?? null) ? $options['delimiter'] : "\t");
    $enclosure = is_string($options['enclosure'] ?? null) ? $options['enclosure'] : '"';
    $listDelimiter = is_string($options['list-delimiter'] ?? null) ? $options['list-delimiter'] : '|';

    if (!is_dir($outputDir) && !mkdir($outputDir, 0777, true) && !is_dir($outputDir)) {
        fwrite(STDERR, "Error: cannot create output directory '$outputDir'.\n");
        return 1;
    }

    $errorLogPath = is_string($options['error-log'] ?? null)
        ? $options['error-log']
        : ErrorLog::pathFor(PROJECT_ROOT . '/logs', $runToken);
    $errorLog = new ErrorLog($errorLogPath);
    $errorLog->open();
    $errorLog->write('Run started ' . date('Y-m-d H:i:s'));
    $errorLog->write("Input: $inputPath");
    $errorLog->write('');

    $caster = new ValueCaster();
    $folioUtils = new FolioUtils();
    $registry = new ReferenceRegistry();

    try {
        $instanceMapper = FieldMapper::fromFile($mappingDir . '/instance_field_mapping.json');
        $holdingsMapper = FieldMapper::fromFile($mappingDir . '/holdings_field_mapping.json');
        $itemMapper = FieldMapper::fromFile($mappingDir . '/item_field_mapping.json');
    } catch (\RuntimeException $e) {
        fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
        return 1;
    }

    $configOption = is_string($options['config'] ?? null) ? $options['config'] : '';
    if ($configOption === '') {
        $configOption = ConfigFile::promptFor(PROJECT_ROOT);
    }

    resolveResourceTypeLiteral(
        $instanceMapper,
        is_string($options['resource-type'] ?? null) ? $options['resource-type'] : '',
        $configOption
    );
    try {
        $refDir = is_string($options['reference-map-dir'] ?? null) ? rtrim($options['reference-map-dir'], '/\\') : REFERENCE_MAP_DIR;
        $refMaps = [
            [$holdingsMapper, 'permanentLocationId', 'location', 'location-map', '', 'location'],
            [$holdingsMapper, 'callNumberTypeId', 'call number type', 'call-number-type-map', '', 'callnumber'],
            [$itemMapper, 'permanentLoanTypeId', 'loan type', 'loan-type-map', '', 'loan'],
            [$itemMapper, 'materialTypeId', 'material type', 'material-type-map', '', 'material'],
            [$itemMapper, 'status.name', 'item status', 'item-status-map', 'Item_Status_Current_Status', 'status'],
        ];
        foreach ($refMaps as [$mapper, $field, $label, $opt, $defaultCol, $keyword]) {
            $map = promptForReferenceMap($label, $refDir, is_string($options[$opt] ?? null) ? $options[$opt] : '', $keyword);
            if ($map !== null) {
                $mapper->setValueMap($field, $map, $defaultCol);
                $errorLog->write("Reference map for $field: $label");
            }
        }
    } catch (\RuntimeException $e) {
        fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
        return 1;
    }

    $materialTypeOption = is_string($options['material-type'] ?? null) ? $options['material-type'] : '';
    if ($materialTypeOption !== '') {
        $itemMapper->setLiteral('materialTypeId', $materialTypeOption);
    }
    $loanTypeOption = is_string($options['loan-type'] ?? null) ? $options['loan-type'] : '';
    if ($loanTypeOption !== '') {
        $itemMapper->setLiteral('permanentLoanTypeId', $loanTypeOption);
    }

    if (isset($options['suppress'])) {
        $suppressInstances = $options['suppress'] !== 'no';
    } else {
        fwrite(STDERR, 'Suppress all instance records from discovery? [y/N]: ');
        $suppressInstances = in_array(strtolower(trim((string) fgets(STDIN))), ['y', 'yes'], true);
    }

    try {
        chooseStatisticalCode(
            [$instanceMapper, $holdingsMapper, $itemMapper],
            $configOption,
            is_string($options['statistical-code'] ?? null) ? $options['statistical-code'] : ''
        );
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
        return 1;
    }

    $testMode = isset($options['test']);
    if ($testMode) {
        $itemMapper->setLiteral('materialTypeId', 'Migration');
        $holdingsMapper->setLiteral('permanentLocationId', 'Migration');
    }

    try {
        [$statisticalCodes, $holdingsSources, $locations, $liveReferences] = buildLiveResolvers(
            $instanceMapper,
            $holdingsMapper,
            $itemMapper,
            $configOption
        );
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
        return 1;
    }

    $fallbackProblems = checkLiveFallbacksExist($itemMapper, $holdingsMapper, $locations, $liveReferences);
    if ($fallbackProblems !== []) {
        foreach ($fallbackProblems as $problem) {
            fwrite(STDERR, "Error: $problem\n");
        }
        return 1;
    }

    $instanceBuilder = new RecordBuilder($instanceMapper, $caster, $folioUtils, InstanceSchema::class, $listDelimiter, $registry, $statisticalCodes, null, null, $liveReferences);
    $holdingsBuilder = new RecordBuilder($holdingsMapper, $caster, $folioUtils, HoldingsSchema::class, $listDelimiter, $registry, $statisticalCodes, $holdingsSources, $locations, $liveReferences);
    $itemBuilder = new RecordBuilder($itemMapper, $caster, $folioUtils, ItemSchema::class, $listDelimiter, $registry, $statisticalCodes, null, null, $liveReferences);

    $reader = new DelimitedFileReader($inputPath, $delimiter, $enclosure);
    try {
        $reader->open();
    } catch (\RuntimeException $e) {
        fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
        return 1;
    }

    $instances = [];
    $holdings = [];
    $items = [];
    $instanceIdByKey = [];
    $holdingsIdByKey = [];
    $hadErrors = false;
    $skippedItems = 0;
    $migrationFallbacks = [];

    foreach ($reader->rows() as $rowNum => $row) {
        $instanceKey = RecordGrouping::instanceKey($row);

        if (!isset($instanceIdByKey[$instanceKey])) {
            $instanceResult = $instanceBuilder->build($row, $rowNum);
            $instanceErrors = $instanceResult->getErrors();
            foreach ($instanceErrors as $error) {
                $errorLog->write($error);
            }
            if ($instanceErrors !== []) {
                $hadErrors = true;
            }
            if (RowValidation::hasFatalErrors($instanceErrors)) {
                $errorLog->write("Row $rowNum: skipped - instance failed validation.");
                $errorLog->write('');
                $skippedItems++;
                continue;
            }

            $instance = $instanceResult->getRecord();
            $instance['id'] = $registry->resolve('instance', $instanceKey, $rowNum);
            $instance['legacyIdentifier'] = LegacyIdentifier::compute($row);
            if ($suppressInstances) {
                $instance['discoverySuppress'] = true;
            }
            $instanceIdByKey[$instanceKey] = $instance['id'];
            $instances[] = $instance;
        }
        $instanceId = $instanceIdByKey[$instanceKey];

        $holdingsKey = RecordGrouping::holdingsKey($row);

        if (!isset($holdingsIdByKey[$holdingsKey])) {
            $holdingsResult = $holdingsBuilder->build($row, $rowNum);
            $holdingsErrors = $holdingsResult->getErrors();
            foreach ($holdingsErrors as $error) {
                $errorLog->write($error);
            }
            if ($holdingsErrors !== []) {
                $hadErrors = true;
            }
            if (RowValidation::hasFatalErrors($holdingsErrors)) {
                $errorLog->write("Row $rowNum: skipped - holdings failed validation.");
                $errorLog->write('');
                $skippedItems++;
                continue;
            }

            tallyMigrationFallback($migrationFallbacks, $holdingsMapper, 'permanentLocationId', $row);
            $holdingsRecord = $holdingsResult->getRecord();
            $holdingsRecord['id'] = $registry->resolve('holdings', $holdingsKey, $rowNum);
            $holdingsRecord['instanceId'] = $instanceId;
            $holdingsIdByKey[$holdingsKey] = $holdingsRecord['id'];
            $holdings[] = $holdingsRecord;
        }
        $holdingsId = $holdingsIdByKey[$holdingsKey];

        $itemResult = $itemBuilder->build($row, $rowNum);
        $itemErrors = $itemResult->getErrors();
        foreach ($itemErrors as $error) {
            $errorLog->write($error);
        }
        if ($itemErrors !== []) {
            $hadErrors = true;
        }
        if (RowValidation::hasFatalErrors($itemErrors)) {
            $errorLog->write("Row $rowNum: skipped - item failed validation.");
            $errorLog->write('');
            $skippedItems++;
            continue;
        }

        tallyMigrationFallback($migrationFallbacks, $itemMapper, 'materialTypeId', $row);
        $item = $itemResult->getRecord();
        $item['id'] = $registry->resolve('item', LegacyIdentifier::compute($row), $rowNum);
        $item['holdingsRecordId'] = $holdingsId;
        $items[] = $item;
    }
    $reader->close();

    $filePrefix = basename($mappingDir) . '_';
    writeRecords($instances, $outputDir . "/{$filePrefix}instances.json", $format);
    writeRecords($holdings, $outputDir . "/{$filePrefix}holdings.json", $format);
    writeRecords($items, $outputDir . "/{$filePrefix}items.json", $format);

    $errorLog->write('');
    reportMigrationFallbacks($migrationFallbacks, $errorLog);
    $errorLog->write(sprintf(
        'Built %d instance(s), %d holdings record(s), %d item(s); skipped %d row(s) with a failing record.',
        count($instances),
        count($holdings),
        count($items),
        $skippedItems
    ));
    $errorLog->close();

    fwrite(STDERR, sprintf(
        "Built %d instance(s), %d holdings record(s), %d item(s); skipped %d row(s) with a failing record. Log: %s\n",
        count($instances),
        count($holdings),
        count($items),
        $skippedItems,
        $errorLogPath
    ));
    fwrite(STDERR, 'Output files: ' . realpath($outputDir) . "\n");
    foreach (['instances', 'holdings', 'items'] as $name) {
        $file = "$outputDir/{$filePrefix}$name.json";
        if (is_file($file)) {
            fwrite(STDERR, '  ' . realpath($file) . "\n");
        }
    }

    return $hadErrors ? 1 : 0;
}

exit(main($argv));
