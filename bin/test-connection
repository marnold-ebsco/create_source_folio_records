#!/usr/bin/env php
<?php declare(strict_types=1);

/**
 * bin/test-connection
 *
 * Verifies a FOLIO connection config actually authenticates and can
 * reach the tenant, before running `bin/build-inventory --config=...` or
 * `bin/load-inventory --config=...` and finding out partway through -
 * e.g. `bin/build-inventory`'s live reference lookups (statistical
 * codes, holdings sources, locations, material/loan types, etc.) all
 * fail the same way a bad config would: silently, or deep into a run.
 * Read-only: logs in and makes one lightweight GET request; never
 * writes anything to the tenant.
 *
 * Usage:
 *   php bin/test-connection [--config=PATH]
 *
 * Options:
 *   --config=PATH   INI file with FOLIO connection settings, per
 *                    \phpFolioClient\FolioConfig (okapiUrl, tenant_id,
 *                    username, password; sslVerify/timeout/debug/etc.
 *                    optional). If omitted and any *.ini file exists at
 *                    the project root, you're prompted to pick one (see
 *                    \SourceFolioRecords\Cli\ConfigFile::promptFor()).
 *   --help          Show this message.
 */

require __DIR__ . '/../vendor/autoload.php';

use SourceFolioRecords\Cli\ConfigFile;
use SourceFolioRecords\Cli\Options;
use phpFolioClient\FolioAuth;
use phpFolioClient\FolioClient;
use phpFolioClient\FolioConfig;
use phpFolioClient\FolioUtils;

const PROJECT_ROOT = __DIR__ . '/..';

function printHelp(): void {
    $source = file_get_contents(__FILE__);
    if (preg_match('#/\*\*(.*?)\*/#s', (string) $source, $m)) {
        foreach (explode("\n", $m[1]) as $line) {
            echo ltrim(rtrim($line), " \t*") . "\n";
        }
    }
}

function main(array $argv): int {
    $options = Options::parse($argv);

    if (isset($options['help'])) {
        printHelp();
        return 0;
    }

    $configOption = is_string($options['config'] ?? null) ? $options['config'] : '';
    if ($configOption === '') {
        $configOption = ConfigFile::promptFor(PROJECT_ROOT);
    }
    if ($configOption === '') {
        fwrite(STDERR, "Error: no config file given, and none found (or chosen) under the project root. Use --config=PATH.\n");
        return 1;
    }

    try {
        $config = new FolioConfig($configOption);
    } catch (\Throwable $e) {
        fwrite(STDERR, "Error: couldn't read '$configOption': " . $e->getMessage() . "\n");
        return 1;
    }

    fwrite(STDERR, "Connecting to {$config->okapiUrl} (tenant {$config->tenant_id}) using '$configOption'...\n");

    try {
        $auth = new FolioAuth($config);
        $client = new FolioClient($config, $auth, new FolioUtils());
        $auth->getAccessToken();
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
        return 1;
    }
    fwrite(STDERR, "Authenticated successfully.\n");

    try {
        $locationCount = 0;
        foreach ($client->get('locations') as $location) {
            $locationCount++;
        }
    } catch (\Throwable $e) {
        fwrite(STDERR, 'Error: authenticated, but a read request failed: ' . $e->getMessage() . "\n");
        return 1;
    }

    fwrite(STDERR, "Connection OK - read $locationCount location(s) from the tenant.\n");
    return 0;
}

exit(main($argv));
